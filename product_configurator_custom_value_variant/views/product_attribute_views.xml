<odoo>
    <record id="product_attribute_form_view" model="ir.ui.view">
        <field
            name="name"
        >Add create custom value to product attribute form view</field>
        <field name="model">product.attribute</field>
        <field
            name="inherit_id"
            ref="product_configurator.product_attribute_form_view"
        />
        <field name="arch" type="xml">
            <field name="custom_type" position="after">
                <field name="create_attribute_value" />
            </field>
        </field>
    </record>
</odoo>
